# Copy to config/.env, which is gitignored. Never commit a filled-in copy.
#
#   cp config/.env.example config/.env
#
# Everything here has a safe default, so the orchestrator runs with no .env at
# all: fixture mode, no network, no credentials.

# --- access mode -------------------------------------------------------------
# fixture   reads canned JSON from fixtures/, writes nothing            (default)
# dry-run   reads the real Jira, prints writes instead of sending them
# live      reads and writes the real Jira
ORC_JIRA_MODE=fixture

# The second switch. Writes reach Jira only when the mode is live AND this is 0.
# Two independent guards, both defaulting to safe.
DRY_RUN=1

# --- personal Jira Cloud -----------------------------------------------------
# Needed for dry-run and live only.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=            # id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT=ORC

# The link type used when refinement finds a duplicate. Site-dependent.
JIRA_DUPLICATE_LINK_TYPE=Duplicate

# --- Figma design context ----------------------------------------------------
# Optional. When a ticket's description links a Figma frame, refinement reads
# its layer/text structure and - when layout plausibly matters - a rendered
# image, and folds both into what it reasons about. Absent, refinement behaves
# exactly as it does with no Figma integration at all: nothing is fetched, and
# a ticket's raw Figma link is left for the refiner to read as plain text, same
# as today.
# Generate one at figma.com -> account settings -> Personal access tokens.
FIGMA_TOKEN=

# --- the repositories refinement reads ---------------------------------------
# Which repositories exist, where, and on which branch is config/projects.yml.
# It is reviewed source, so it is not set here.
#
# TARGET_REPO is the original single-repository setup and still works: it fills
# in the path for a project the config gives none for. It cannot override a path
# the config states, because it has no way to say which project it means.
# Refinement is read-only against every one of them and asserts as much.
TARGET_REPO=

# Where the clones the orchestrator owns live. Derived state: gitignored,
# disposable, and rebuilt by bin/orc-repos-sync.sh.
ORC_CLONE_DIR=

# Whether refinement fetches before it reasons. A stale checkout is the failure
# that matters most here: it makes a verdict confidently wrong, and that is
# indistinguishable from bad judgment weeks later.
#   auto  fetch when config/projects.yml names a remote            (default)
#   on    always fetch
#   off   never fetch; reason against whatever is on disk and say so
ORC_REPO_SYNC=auto

# How long a fetch stays fresh, in seconds. A five-ticket pass must not mean
# five fetches of the same three repositories.
ORC_REPO_SYNC_TTL=300

# --- the knowledge bundle ----------------------------------------------------
# Where the bundle refinement reads lives. Empty means .okf/ beside this
# repository, which is where bin/orc-onboard.sh drafts one. No bundle ships:
# a bundle is knowledge about one organisation's product.
#
# Set this and an installation keeps its own knowledge outside the tree, the same
# way ORC_SOLVED_DIR keeps its own solved tickets outside it. That is what makes
# this repository handable to somebody else, and it is also how a second bundle
# gets drafted without a second checkout.
#
# A --bundle DIR flag on the scripts that take one still wins over this.
ORC_BUNDLE_DIR=

# --- the solved set ----------------------------------------------------------
# Which already-solved tickets bin/orc-locality-score.sh scores against. Empty
# means fixtures/solved/, the invented example set, which runs offline and scores
# nothing because none of its tickets names a repository this config gives.
#
# A real set is your own organisation's tickets and belongs outside this
# repository: fixtures are committed, and ticket text carries reporter names and
# whatever somebody pasted in. See fixtures/solved/README.md for the layout.
ORC_SOLVED_DIR=

# Whether a daemon pass asks if the knowledge bundle still says what the
# repositories say, and warns by name when it does not. It only ever warns:
# the bundle is source, so re-drafting is a human's move.
#   auto  ask, if there is a bundle to ask about                   (default)
#   off   never ask
ORC_BUNDLE_CHECK=auto

# How long that answer stays fresh, in seconds, and how long the asking may take.
# It re-renders every concept from every repository, so on a sixty-second poll it
# must not happen every pass. 0 means every pass.
ORC_BUNDLE_CHECK_TTL=3600
ORC_BUNDLE_CHECK_TIMEOUT=120

# --- the review queue ------------------------------------------------------
# bin/orc-verify.sh queue ends with an advisory list of verified concepts whose
# signature has not been renewed in this many days. It is advisory only: those
# concepts are already decided, so it moves neither the queue's item counts nor
# its exit code, and it never reaches the refiner. Age is not staleness - the
# list is a prompt to re-read, not a verdict. 180 days is two-plus release
# cycles for most fleets: long enough that the list stays short and each entry
# is worth a look, short enough to catch a boundary or enum that has since
# moved. A non-number disables the list.
ORC_VERIFY_STALE_DAYS=180

# --- labels the orchestrator writes ------------------------------------------
# Each one is put on a ticket by this system to record a state it reached itself.
LABEL_READY=agent-ready
LABEL_NEEDS_INPUT=needs-refinement
LABEL_IN_PROGRESS=agent-working
LABEL_DUPLICATE=possible-duplicate

# --- the label the orchestrator reads ----------------------------------------
# The opt-in gate: name a label here and only cards carrying it are polled and
# refined. This is the one label that is read and never written - nothing in this
# system adds it or takes it off, so the set of cards in scope is a human's
# decision and stays one.
#
# Empty means off, and off means what it has always meant: every ticket in the
# project that changed. Setting it is how you hand-pick cards; unsetting it puts
# the whole project back in scope.
#
# Labelling a card is itself an edit, so Jira moves its `updated` and the next
# poll sees it. A card labelled before the gate was configured needs no relabel
# either, only a watermark that reaches back far enough: state/ is a cache, so
# delete state/.jira-watermark to ask from the beginning.
LABEL_OPT_IN=

# --- refinement --------------------------------------------------------------
# auto    replay canned verdicts in fixture mode, call the agent otherwise
# claude  always call the agent (needs network)
# replay  always replay canned verdicts (offline, deterministic)
ORC_REFINER=auto

# --- loop --------------------------------------------------------------------
ORC_POLL_INTERVAL=60
ORC_HTTP_RETRIES=4
