{
  "id": "1101",
  "key": "ORC-101",
  "fields": {
    "summary": "Follow-up unlock stays disabled after the authorisation is claimed (dashboard, doctor role)",
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A doctor cannot open a follow-up whose authorisation has already been claimed. The unlock control on the examination tab stays disabled, so the case cannot be worked on at all."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Steps to reproduce"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Seed a closed case with a claimed follow-up authorisation (fixture `cases:closed_with_claimed_follow_up`)."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Log in to the dashboard as a doctor who is a member of the case's clinic."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Open the case and select the Examination tab."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Look at the \"Open follow-up\" control in the follow-up decision panel."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Expected"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The control is enabled, and activating it opens the follow-up for examination."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Actual"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The control is disabled and its tooltip reads \"waiting for authorisation\". The API returns the follow-up with `authorisation_claimed_at` set, so the state is correct server side and the dashboard is reading the wrong field."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A doctor on a case whose follow-up authorisation is claimed can open the follow-up from the examination tab."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A doctor on a case whose authorisation is not claimed still sees the control disabled with the existing tooltip."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The regression is covered by a test at the level where the bug lives."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Affected surface"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dashboard only. The API response is already correct, confirmed against the serializer output in the reproduction above."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Out of scope"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Anything about follow-up pricing, and the mobile app's own follow-up wizard."
            }
          ]
        }
      ]
    },
    "labels": [],
    "issuetype": {
      "name": "Bug"
    },
    "status": {
      "name": "To Do",
      "statusCategory": {
        "key": "new",
        "name": "To Do"
      }
    },
