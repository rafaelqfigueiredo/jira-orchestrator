  "fields": {
    "summary": "Doctor cannot start a follow-up the patient has already paid for",
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Reported by the clinic in the Tuesday call. A patient pays for a follow-up, the payment goes through, and the doctor still cannot start it: the button on the examination tab is greyed out and hovering it says something about waiting for an authorisation, even though the patient has paid."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Happens in the dashboard. I have not tried the mobile app."
