{
  "id": "1105",
  "key": "ORC-105",
  "fields": {
    "summary": "Follow-up improvements",
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Collecting the follow-up work we agreed in the planning session so it does not get lost."
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Rename \"Recheck\" to \"Follow-up\" everywhere it still appears in the patient app and in the dashboard, including the localised strings."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Send an event to the CRM whenever a follow-up authorisation is claimed, so the lifecycle campaigns can react to it. The CRM sync already handles case closure, so this should slot into the same place."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Fix the case list so a follow-up appears grouped under the case it came from instead of as its own top-level row. Right now a patient with three follow-ups sees four unrelated cases."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Backfill authorisation rows for the legacy cases that were created with a parent but no claim record, so reporting stops counting them as follow-ups."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The first one is quick, the last one needs care because of the volume of legacy rows."
            }
          ]
        }
      ]
    },
    "labels": [],
    "issuetype": {
      "name": "Story"
    },
